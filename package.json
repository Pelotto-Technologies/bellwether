{
  "name": "bellwether",
  "private": true,
  "description": "Pixel stream overlay for Herdr agent workspaces",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test tools/readme-links.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --filter @bellwether/adapter build && pnpm -r --parallel dev",
    "shell": "pnpm --filter @bellwether/adapter --filter @bellwether/renderer build && pnpm --filter @bellwether/shell start",
    "mock": "pnpm --filter @bellwether/adapter build && pnpm --filter @bellwether/renderer build && node packages/adapter/dist/bin.js --mock --serve packages/renderer/dist",
    "bellwether": "node tools/bellwether.mjs",
    "blog": "pnpm --filter @bellwether/renderer build && node tools/blog-build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
